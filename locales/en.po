msgid "SKILL_instant_double_shot"
msgstr "Instant Double Shot"

msgid "SKILL_instant_double_shot_DESC"
msgstr "Fires two rapid consecutive shots with 200% critical damage."

msgid "SKILL_dark_volley"
msgstr "Dark Volley"

msgid "SKILL_dark_volley_DESC"
msgstr "Enters focus stance for 2 seconds and fires a burst of 10 energized arrows at the strongest target."

msgid "SKILL_precision_shot"
msgstr "Precision Shot"

msgid "SKILL_precision_shot_DESC"
msgstr "A 0.4s charged shot that guarantees a critical hit and ignores 30% armor."

msgid "SKILL_hunter_stance"
msgstr "Hunter Stance"

msgid "SKILL_hunter_stance_DESC"
msgstr "Plants feet lightly and gains 30% Attack Speed and 10% Physical Damage for 3.5 seconds."

msgid "SKILL_neon_vision"
msgstr "Neon Vision"

msgid "SKILL_neon_vision_DESC"
msgstr "Eyes glow intense neon green, increasing Critical Hit Rate by 30% and making all arrows pierce the first enemy for 4 seconds."

msgid "SKILL_armor_penetration"
msgstr "Armor Penetration"

msgid "SKILL_armor_penetration_DESC"
msgstr "Basic attacks and skills ignore a portion of armored or boss enemy defense."

msgid "SKILL_reflex_recoil"
msgstr "Reflex Recoil"

msgid "SKILL_reflex_recoil_DESC"
msgstr "When HP drops below 25%, gains a temporary shield and a large movement speed boost for 3 seconds."

msgid "SKILL_swift_execution"
msgstr "Swift Execution"

msgid "SKILL_swift_execution_DESC"
msgstr "Deals 20% more damage to enemies below 30% max HP."

msgid "SKILL_nimble_hands"
msgstr "Nimble Hands"

msgid "SKILL_nimble_hands_DESC"
msgstr "Reduces cooldown of all active skills by 15%."

msgid "SKILL_eagle_eye"
msgstr "Eagle Eye"

msgid "SKILL_eagle_eye_DESC"
msgstr "Increases critical hit rate and on-screen vision range."

msgid "SKILL_drawstring_tension"
msgstr "Drawstring Tension"

msgid "SKILL_drawstring_tension_DESC"
msgstr "Reduces frontal shot animation time, increasing basic Attack Speed by 15%."

msgid "SKILL_wearing_poison"
msgstr "Wearing Poison"

msgid "SKILL_wearing_poison_DESC"
msgstr "5% chance to apply poison on basic attacks."

msgid "SKILL_weak_prey"
msgstr "Weak Prey"

msgid "SKILL_weak_prey_DESC"
msgstr "Deals 15% more damage to monsters below 25% HP."

msgid "SKILL_stacking_impact"
msgstr "Stacking Impact"

msgid "SKILL_stacking_impact_DESC"
msgstr "Each arrow hitting the same target within 2s increases next hit damage by 5% (max 25%)."

msgid "SKILL_surgical_aim"
msgstr "Surgical Aim"

msgid "SKILL_surgical_aim_DESC"
msgstr "Increases Critical Hit Rate by 30% against targets above 70% HP."

msgid "SKILL_twin_execution_cut"
msgstr "Twin Execution Cut"

msgid "SKILL_twin_execution_cut_DESC"
msgstr "An X-shaped cross slash with both daggers. Deals double damage to enemies below 30% HP."

msgid "SKILL_prey_mark"
msgstr "Prey Mark"

msgid "SKILL_prey_mark_DESC"
msgstr "Marks a target for 4 seconds. Damage dealt is stored and explodes for 30% bonus damage at the end."

msgid "SKILL_quick_twin_cut"
msgstr "Quick Twin Cut"

msgid "SKILL_quick_twin_cut_DESC"
msgstr "Two ultra-fast cross strikes to the target's chest."

msgid "SKILL_awakened_sequence"
msgstr "Awakened Sequence"

msgid "SKILL_awakened_sequence_DESC"
msgstr "Gains an immediate 60% Attack Speed surge for 4 hits or 3 seconds."

msgid "SKILL_swift_decapitation"
msgstr "Swift Decapitation"

msgid "SKILL_swift_decapitation_DESC"
msgstr "A high neck strike dealing 50% extra damage if the target is below 30% HP."

msgid "SKILL_shadow_reflexes"
msgstr "Shadow Reflexes"

msgid "SKILL_shadow_reflexes_DESC"
msgstr "Increases base Critical Hit Rate and Attack Speed."

msgid "SKILL_adrenaline_surge"
msgstr "Adrenaline Surge"

msgid "SKILL_adrenaline_surge_DESC"
msgstr "Killing an enemy restores 50% cooldown on all active skills."

msgid "SKILL_venomous_vein"
msgstr "Venomous Vein"

msgid "SKILL_venomous_vein_DESC"
msgstr "Increases critical damage by 25% against poisoned or bleeding targets."

msgid "SKILL_stealth_strike"
msgstr "Stealth Strike"

msgid "SKILL_stealth_strike_DESC"
msgstr "First hit when entering combat deals 50% additional critical damage."

msgid "SKILL_lethal_execution"
msgstr "Lethal Execution"

msgid "SKILL_lethal_execution_DESC"
msgstr "Attacks on targets below 15% max HP may instantly execute (except stage bosses)."

msgid "SKILL_deep_cut"
msgstr "Deep Cut"

msgid "SKILL_deep_cut_DESC"
msgstr "Bleeds from daggers last 1.5s longer."

msgid "SKILL_weak_point_mapping"
msgstr "Weak Point Mapping"

msgid "SKILL_weak_point_mapping_DESC"
msgstr "Ignores 20% of enemy base armor."

msgid "SKILL_adrenaline"
msgstr "Adrenaline"

msgid "SKILL_adrenaline_DESC"
msgstr "Killing an enemy resets 1 second of cooldown on all active skills."

msgid "SKILL_assassin_rhythm"
msgstr "Assassin Rhythm"

msgid "SKILL_assassin_rhythm_DESC"
msgstr "Each active skill hit adds 10% Attack Speed (stacks up to 5 times, +50% for 4s)."

msgid "SKILL_light_blade"
msgstr "Light Blade"

msgid "SKILL_light_blade_DESC"
msgstr "Increases damage by 10%."

msgid "SKILL_sacred_position"
msgstr "Sacred Position"

msgid "SKILL_sacred_position_DESC"
msgstr "Instantly restores a portion of the lowest-HP ally's health."

msgid "SKILL_solar_shield"
msgstr "Solar Shield"

msgid "SKILL_solar_shield_DESC"
msgstr "Grants a bright light shield to the most vulnerable ally, absorbing damage for 3 seconds."

msgid "SKILL_divine_punishment"
msgstr "Divine Punishment"

msgid "SKILL_divine_punishment_DESC"
msgstr "Calls a vertical beam of light on the densest enemy group, dealing elemental damage."

msgid "SKILL_inviolability_aura"
msgstr "Inviolability Aura"

msgid "SKILL_inviolability_aura_DESC"
msgstr "Creates a 1.5s dome that reduces all party damage taken by 15% and heals over time."

msgid "SKILL_sacred_fervor"
msgstr "Sacred Fervor"

msgid "SKILL_sacred_fervor_DESC"
msgstr "Raises the staff and channels a bright aura, increasing party damage by 15% for 4 seconds."

msgid "SKILL_sun_touch"
msgstr "Sun Touch"

msgid "SKILL_sun_touch_DESC"
msgstr "Increases healing power and shield effectiveness by 20%."

msgid "SKILL_reactive_barrier"
msgstr "Reactive Barrier"

msgid "SKILL_reactive_barrier_DESC"
msgstr "When HP drops below 30%, automatically gains a divine shield equal to 35% max HP (30s cooldown)."

msgid "SKILL_radiant_presence"
msgstr "Radiant Presence"

msgid "SKILL_radiant_presence_DESC"
msgstr "Nearby allies gain 10% physical and magic damage resistance."

msgid "SKILL_unshakable_devotion"
msgstr "Unshakable Devotion"

msgid "SKILL_unshakable_devotion_DESC"
msgstr "Reduces cooldown of all heal and shield skills by 15%."

msgid "SKILL_divine_vigor"
msgstr "Divine Vigor"

msgid "SKILL_divine_vigor_DESC"
msgstr "Converts overheal into a small temporary shield."

msgid "SKILL_sacred_touch"
msgstr "Sacred Touch"

msgid "SKILL_sacred_touch_DESC"
msgstr "Priest basic attacks have 15% chance to heal the most wounded ally."

msgid "SKILL_critical_heal"
msgstr "Critical Heal"


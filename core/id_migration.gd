static func migrate_item_id(item_id: String) -> String:
	if item_id == "":
		return ""
	var base := item_id
	var suffix := ""
	var idx := item_id.rfind("_")
	if idx > 0:
		var tail := item_id.substr(idx + 1)
		if tail.is_valid_int() or tail.is_valid_float():
			base = item_id.substr(0, idx)
			suffix = item_id.substr(idx)
	return str(ITEM_IDS.get(base, base)) + suffix

static func migrate_skill_id(skill_id: String) -> String:
	if skill_id == "":
		return ""
	return str(SKILL_IDS.get(skill_id, skill_id))
